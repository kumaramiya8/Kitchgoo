# ─── Kitchgoo — Environment Variables ────────────────────────
# Copy this file to .env and fill in your credentials.
#
# Setup steps:
#   1. Go to https://supabase.com and create a free account
#   2. Create a new project (choose any region, set a DB password)
#   3. Once the project is ready, open SQL Editor and run supabase-schema.sql
#   4. Then run supabase-rls.sql to lock tables to server-only access
#   5. Go to Project Settings → API and copy the keys below
#   6. Rename this file to .env and restart the dev server

# Used by the browser ONLY for realtime broadcast subscriptions (safe to ship)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── Server-only secrets (never exposed to the browser) ──────

# "service_role" key from Project Settings → API. The backend uses this to
# access the database; RLS blocks everything else.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Secret for signing session JWTs. Required in production.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Kitchgoo Copilot — Zenoti internal LLM gateway (Zeenie).
# Raise a Jira ticket for LLM API access; the key arrives by email.
ZEENIE_API_KEY=
# Optional model override (default: claude-4.5-haiku)
# ZEENIE_MODEL=claude-4.6-sonnet
